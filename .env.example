# Back-Template — Environment Variables
#
# Copy this file to .env and fill in real values for local development.
# .env is gitignored. Never commit secrets.

# ---- Runtime ----
NODE_ENV=development
PORT=3000

# ---- Database (PostgreSQL) ----
# Required. Example local: postgresql://postgres:postgres@localhost:5432/back_template
DATABASE_URL=

# ---- JWT (auth) ----
# Required. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Defaults shown — adjust per project.
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d
# Disable to skip issuing refresh tokens (single-token auth).
JWT_REFRESH_ENABLED=true

# ---- Auth ----
# When true, tokens are returned as httpOnly cookies in addition to the body.
AUTH_COOKIE_ENABLED=false

# ---- Throttling ----
# Global rate limit (per IP). ttl in ms.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ---- Logging ----
# pino levels: trace, debug, warn, error, fatal, info (default)
LOG_LEVEL=info

# ---- CORS ----
# Comma-separated list of allowed origins. Defaults to localhost:3000 in dev.
CORS_ORIGINS=http://localhost:3000

# ---- Swagger ----
# When NODE_ENV=development the UI is served at /api/docs regardless of this flag.
# In production, set SWAGGER_ENABLED=true to expose it (default false = 404 in prod).
SWAGGER_ENABLED=false